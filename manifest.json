{
  "manifest_version": 3,
  "name": "kancolle-PIP",
  "version": "0.1.0",
  "description": "艦これの画面をPicture-in-Pictureで表示する拡張機能です。",
  "content_scripts": [
    {
      "matches": [
        "*://*.dmm.com/*",
        "*://*.dmm.co.jp/*",
        "*://*.kancolle-server.com/*"
      ],
      "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
      "css": ["styles.css"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}